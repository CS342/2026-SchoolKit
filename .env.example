# Supabase Configuration
# Get these values from your Supabase project settings: https://app.supabase.com
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# That's all the client needs. API keys for OpenAI and ElevenLabs are
# server-side Supabase Edge Function secrets — never EXPO_PUBLIC_* — set with:
#   supabase secrets set OPENAI_API_KEY=sk-...
#   supabase secrets set ELEVENLABS_API_KEY=...

# Optional, local only: an ElevenLabs key restricted to *reading voices* (no text-to-speech
# access, so it can't spend credits). Used by scripts/search-voices.js to find new guides.
# ELEVENLABS_VOICES_KEY=...
